# =============================================================================
# MAYA Front Desk — Database Connection Template
# Share this template with Siddharth (backend).
# He fills in DATABASE_PASSWORD from GCP Secret Manager.
# =============================================================================

# --- For local development via Cloud SQL Auth Proxy ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=maya_frontdesk
DATABASE_USER=maya_app
DATABASE_PASSWORD=<fetch from: gcloud secrets versions access latest --secret=maya-db-password --project=maya-frontdesk>
DATABASE_URL=postgresql+asyncpg://maya_app:${DATABASE_PASSWORD}@127.0.0.1:5432/maya_frontdesk

# --- For Cloud Run (uses Unix socket via built-in Auth Proxy) ---
# DATABASE_URL=postgresql+asyncpg://maya_app:${DATABASE_PASSWORD}@/maya_frontdesk?host=/cloudsql/maya-frontdesk:asia-south1:maya-frontdesk-dev

# --- Cloud SQL Info ---
CLOUD_SQL_CONNECTION_NAME=maya-frontdesk:asia-south1:maya-frontdesk-dev
CLOUD_SQL_INSTANCE=maya-frontdesk-dev
GCP_PROJECT=maya-frontdesk
GCP_REGION=asia-south1
