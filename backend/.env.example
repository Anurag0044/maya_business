APP_NAME=MAYA Front Desk
ENVIRONMENT=development
DEBUG=true

# ── DATABASE_URL ──────────────────────────────────────────────────────────────
# config.py reads this single variable. Use the right format for your environment.
# All variants use the asyncpg driver (postgresql+asyncpg://).
#
# 1. Local Docker / dev (default):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/maya_frontdesk
#
# 2. Cloud Shell via Cloud SQL Auth Proxy (for Alembic migrations):
#    Start proxy first: ~/cloud-sql-proxy maya-frontdesk:asia-south1:maya-frontdesk-dev --port=5432
#    DATABASE_URL=postgresql+asyncpg://maya_app:PASSWORD@127.0.0.1:5432/maya_frontdesk
#
# 3. Cloud Run (built-in Auth Proxy, Unix socket — injected from Secret Manager):
#    DATABASE_URL=postgresql+asyncpg://maya_app:PASSWORD@/maya_frontdesk?host=/cloudsql/maya-frontdesk:asia-south1:maya-frontdesk-dev
#    Secret name: maya-database-url (DevOps team manages this)
# ─────────────────────────────────────────────────────────────────────────────

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

TIMEZONE=Asia/Kolkata
